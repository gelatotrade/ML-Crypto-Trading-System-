# ML Crypto Trading System Configuration
# Copy this to .env and fill in your values

# ===========================================
# TRADING CONFIGURATION
# ===========================================
TRADING_MODE=paper           # paper, live, backtest
PRIMARY_EXCHANGE=lighter     # lighter or hyperliquid
BACKUP_EXCHANGE=hyperliquid
INITIAL_CAPITAL=100000

# ===========================================
# LIGHTER EXCHANGE (Primary)
# ===========================================
LIGHTER_API_KEY=your_lighter_api_key
LIGHTER_API_SECRET=your_lighter_api_secret
LIGHTER_ENABLE_FAST_EXECUTION=true
LIGHTER_FAST_EXECUTION_FEE=1.5

# ===========================================
# HYPERLIQUID (Backup)
# ===========================================
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=
DEX_PRIVATE_KEY=your_ethereum_private_key

# ===========================================
# MARKET DATA SOURCES
# ===========================================
# Yahoo Finance (free, no key needed)
YAHOO_FINANCE_ENABLED=true

# Alpha Vantage (free tier: 5 req/min, 500/day)
ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep (free tier: 250 req/day)
FMP_API_KEY=

# Polygon.io (generous free tier)
POLYGON_API_KEY=

# ===========================================
# OPTIONS DATA (Deribit)
# ===========================================
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
DERIBIT_TESTNET=true
OPTIONS_ENABLED=true
IV_WEIGHT=0.6

# ===========================================
# RISK PARAMETERS
# ===========================================
MAX_LEVERAGE=3.0
MAX_NET_EXPOSURE=0.1         # 10% max for neutrality
MAX_GROSS_EXPOSURE=2.0       # 200% max (100% long + 100% short)
TARGET_VOLATILITY=0.15       # 15% annualized target
MAX_DRAWDOWN=0.15
VAR_CONFIDENCE=0.95
MIN_SHARPE_RATIO=2.5

# Position Limits by Asset Type
POSITION_LIMIT_MAJOR=0.20         # 20% for BTC/ETH
POSITION_LIMIT_ALTCOIN=0.10       # 10% for altcoins
POSITION_LIMIT_MEME=0.05          # 5% for meme tokens (shorts only)
POSITION_LIMIT_DEFLATIONARY=0.15  # 15% for buyback tokens (HYPE)
POSITION_LIMIT_HIGH_UNLOCK=0.08   # 8% for high unlock tokens

# ===========================================
# REGIME DETECTION
# ===========================================
REGIME_DETECTION_ENABLED=true
RISK_ON_BETA=0.3             # Long bias in risk-on
RISK_OFF_BETA=-0.3           # Short bias in risk-off
NEUTRAL_BETA=0.0

# ===========================================
# ML CONFIGURATION
# ===========================================
MODEL_PATH=models/
LSTM_HIDDEN_SIZE=128
LSTM_NUM_LAYERS=2
LSTM_DROPOUT=0.2
SEQUENCE_LENGTH=24
PREDICTION_HORIZON=1
MIN_CONFIDENCE=0.6

# ===========================================
# DATA CONFIGURATION
# ===========================================
LOOKBACK_DAYS=30
OHLCV_TIMEFRAME=1h
ORDERBOOK_DEPTH=20
CACHE_TTL=300

# ===========================================
# EXECUTION
# ===========================================
REBALANCE_INTERVAL=3600      # 1 hour
MIN_TRADE_SIZE=10.0
SLIPPAGE_TOLERANCE=0.002
MAX_ORDER_RETRIES=3
ORDER_TIMEOUT=30

# ===========================================
# CORRELATION SCREENING
# ===========================================
MAX_CORRELATION=0.7          # Block same-direction if > 0.7 corr
CORRELATION_LOOKBACK=168     # 1 week of hourly data

# ===========================================
# TOKEN UNLOCK DATA (Tokenomist + CryptoRank)
# ===========================================
# Tokenomist.ai - Primary source for token unlock schedules
# Get API key at: https://tokenomist.ai
TOKENOMIST_API_KEY=

# CryptoRank.io - Backup source for unlock data
# Get API key at: https://cryptorank.io
CRYPTORANK_API_KEY=

# ===========================================
# INFLATION/DEFLATION STRATEGY
# ===========================================
# Signal weight distribution
ML_WEIGHT=0.70               # 70% weight for ML predictions
INFLATION_WEIGHT=0.30        # 30% weight for inflation/deflation signals

# Unlock analysis thresholds
CRITICAL_UNLOCK_PCT=5.0      # > 5% supply unlock = critical risk
HIGH_UNLOCK_PCT=2.0          # > 2% supply unlock = high risk
MEDIUM_UNLOCK_PCT=1.0        # > 1% supply unlock = medium risk

# Buyback analysis
HYPE_BUYBACK_ENABLED=true    # Track HYPE buybacks from Assistance Fund
BUYBACK_CACHE_TTL=300        # 5 minutes cache for buyback data

# ===========================================
# ORDERBOOK ANALYSIS
# ===========================================
ORDERBOOK_ENABLED=true
ORDERBOOK_DEPTH=50           # Number of price levels to analyze
LARGE_ORDER_USD=100000       # Orders > $100K = large
WHALE_ORDER_USD=1000000      # Orders > $1M = whale
WALL_THRESHOLD_PCT=5.0       # > 5% of depth = wall

# ===========================================
# DRIFT PROTECTION
# ===========================================
# Statistical drift detection thresholds
DRIFT_KS_THRESHOLD=0.1       # KS-Test threshold for distribution change
DRIFT_PSI_THRESHOLD=0.2      # Population Stability Index threshold

# Performance drift thresholds
DRIFT_SHARPE_MIN=0.5         # Minimum acceptable Sharpe ratio
DRIFT_SHARPE_DROP=0.5        # Max Sharpe drop from baseline before alert
DRIFT_DRAWDOWN_THRESHOLD=0.10 # Max drawdown trigger (10%)
DRIFT_HIT_RATE_MIN=0.45      # Minimum acceptable hit rate

# Monitoring windows
DRIFT_BASELINE_DAYS=30       # Days for baseline calculation
DRIFT_DETECTION_DAYS=7       # Days for recent performance comparison
DRIFT_RETRAIN_DAYS=7         # Automatic retraining frequency

# Risk controls during drift
DRIFT_MAX_REDUCTION=0.5      # Max position reduction (50%) on drift
DRIFT_HALT_ON_CRITICAL=true  # Halt trading on critical drift

# Online learning
DRIFT_ONLINE_LEARNING=true   # Enable incremental model updates
DRIFT_LEARNING_RATE=0.01     # Learning rate for online updates
